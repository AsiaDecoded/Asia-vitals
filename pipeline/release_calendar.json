{
 "_about": "Release dates (Singapore dates) for every source. The update workflow runs a source only from its release date to the end of its window; the dashboard refresh task runs on refresh dates derived from these. 'official' dates are from the agency's published calendar; 'expected' dates follow the agency's usual pattern where no calendar is published, with a wider window. Extend before the last date passes: tools/due.py warns 45 days ahead.",
 "_sources_of_dates": {
  "jp_cpi": "Statistics Bureau of Japan, CPI release schedule (stat.go.jp/english/data/cpi/1582.htm)",
  "jp_ppi": "Bank of Japan publishes the next CGPI date only; pattern: 8th Tokyo business day",
  "jp_gdp": "ESRI 2026 schedule (16 Nov, 8 Dec 2026); 2027 dates expected from the usual pattern",
  "in_cpi": "MoSPI Advance Release Calendar 2026-27 (12th of each month; next working day if a holiday)",
  "in_ppi": "Office of the Economic Adviser, Advance Release Calendar WPI/OPPI/IPPI",
  "sg_cpi": "SingStat Advance Release Calendar pattern: 23rd, or next working day",
  "sg_ppi": "SingStat Advance Release Calendar pattern: around the 27th-30th",
  "kr_cpi": "Ministry of Data and Statistics 2026 release schedule (mods.go.kr); 2027 expected from pattern",
  "kr_ppi": "Bank of Korea: no calendar found; pattern: around the 18th-23rd, 06:00 KST",
  "hk_cpi": "C&SD schedule of regular press releases (censtatd.gov.hk press_release.html, data/en/press_release/press_release_index.json), to Dec 2027",
  "hk_ppi": "C&SD schedule of regular press releases: PPI for manufacturing (quarterly) and volume and price statistics of external merchandise trade (monthly), to Dec 2027",
  "my_cpi": "DOSM: next date from OpenDOSM's catalogue (cpi_headline 'next update'); later dates expected from the pattern (around the 19th-23rd, 12:00-12:30 MYT)",
  "my_ppi": "DOSM: next date from OpenDOSM's catalogue (ppi 'next update'); later dates expected from the pattern (around the 26th-30th, 12:00 MYT)",
  "ph_cpi": "PSA: no calendar found; pattern: around the 5th, 09:00 Manila (Sep 2026 CPI released 6 Oct 2026)",
  "ph_ppi": "PSA PPI for manufacturing (MISSI): no calendar found; about two months after the month (Jul 2026 table updated 9 Sep 2026)",
  "th_cpi": "TPSO (Ministry of Commerce): no calendar found; pattern from the Open API's createdAt stamps: CPI and PPI on the 5th-7th, 10:15-14:00 Bangkok (Sep 2026 CPI 6 Oct 2026, 11:32 Bangkok)",
  "th_xmpi": "TPSO export and import price indices: no calendar found; pattern: around the 28th (Sep 2026 on 28 Oct 2026, 11:21 Bangkok; Aug on 28 Sep)",
  "id_cpi": "BPS: CPI on the first working day of the following month, 11:00 Jakarta (12:00 SGT); dates from that pattern. Bank Indonesia's SEKI table VIII.1 carries the data some days later (lag not published), so each window runs three weeks from the BPS release. The BPS WebAPI sources (id_bps) carry the release the same day. The same three-week windows serve Bank Indonesia's SEKI III.3 (JCI month-end, id_jci_seki) and IV.1-IV.4 (fiscal, id_fiscal_seki; id_fiscal_gdp recomputes from it): SEKI stamped III.3 on 5 Oct and IV.1-IV.4 on 6-13 Oct 2026 for the September data",
  "tw_prices": "DGBAS: each monthly release names the next date (Oct 2026 data on 5 Nov 2026, 16:00 Taipei); later dates expected on the pattern (5th working day after the month); the dated calendar page is script-only",
  "cn_prices": "NBS 2026 release calendar (to Dec 2026, 09:30 Beijing); 2027 expected from the pattern until NBS publishes its calendar in late December",
  "vn_prices": "NSO: Decree 13/2026/ND-CP, CPI on the 3rd of the following month (weekends included), about 09:00 Hanoi; no dated calendar found. Quarterly PPI and trade prices come with the quarter-end CPI release",
  "id_gdp": "BPS: no dated calendar fetched; pattern: about the 5th of the second month after the quarter, 11:00 Jakarta (Q2 2026 on 5 Aug 2026); windows +/-3 days",
  "id_fiscal_monthly": "Ministry of Finance APBN KiTa press conference: no calendar found; it has fallen between the 9th and 22nd (Sep 2026 outturn 9 Oct, Aug 18 Sep), so the source runs daily from the 3rd to the 25th; nominal date the 15th",
  "id_debt_imf": "No fixed dates: SUSPI (Bank Indonesia and Ministry of Finance) is quarterly with no calendar found; IMF WEO in April and October, IMF Global Debt Database once a year. A short monthly window (15th-18th) picks each up within a month; every source exits unchanged when nothing is new",
  "id_jci_daily": "Yahoo Finance (^JKSE, id_jci_yahoo; benchmark indices, eq_yahoo): daily closes, fetched once a week, Friday 08:15 SGT (to Thursday's close; both sources keep completed sessions only), with the dashboard refresh that Friday",
  "wb_gni": "World Bank: GNI per capita (WDI) updated each July with the new income classifications, revised at other WDI updates; no calendar used, one check a month (15th); exits unchanged when nothing is new",
  "id_fx": "BIS WS_XRU (id_fx_bis for Indonesia, fx_bis for 10 others): the BIS releases weekly, on Thursdays (data.bis.org: last release 29 Oct 2026, next 5 Nov; data to the Tuesday before), after the Asian runs; so one run a week, Friday 08:15 SGT, and the dashboard refresh that Friday"
 },
